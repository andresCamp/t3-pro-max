<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed: the app reads ~/.t3/userdata/server-runtime.json and runs the
	     user's own `t3` CLI to mint pairing tokens, neither of which a sandbox allows. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
